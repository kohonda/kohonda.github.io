---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PublicationItem from "../components/PublicationItem.astro";
import type { Publication } from "../types/publication";

import preprint from "../content/publication/preprint.json";
import internationalJournal from "../content/publication/international_journal.json";
import internationalConference from "../content/publication/international_conference.json";
import japaneseJournal from "../content/publication/japanese_journal.json";
import japaneseConference from "../content/publication/japanese_conference.json";
import others from "../content/publication/others.json";

const sections: { label: string; items: Publication[] }[] = [
  { label: "Preprint", items: preprint },
  { label: "International Journal", items: internationalJournal },
  { label: "International Conference", items: internationalConference },
  { label: "Japanese Journal", items: japaneseJournal },
  { label: "Japanese Conference", items: japaneseConference },
  { label: "Others", items: others },
];

---

<BaseLayout title="Publications | Kohei Honda">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900">Publications</h1>

  {
    sections.map((section) => (
      <Section title={section.label}>
        <ul class="grid gap-3">
          {section.items.map((pub) => (
            <PublicationItem pub={pub} />
          ))}
        </ul>
      </Section>
    ))
  }
</BaseLayout>
