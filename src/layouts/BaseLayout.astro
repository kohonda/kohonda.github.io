---
import BaseHead from "../components/BaseHead.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const { image, title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-zinc-800 antialiased">
    <NavBar />
    <main class="mx-auto w-full max-w-3xl grow px-5 py-10 sm:py-14">
      <slot />
    </main>
    <Footer />
  </body>
</html>
