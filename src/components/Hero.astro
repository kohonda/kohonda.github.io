---
import { Icon } from "astro-icon/components";
import SocialLinks from "./SocialLinks.astro";

const keywords = [
  "Mobile Robotics",
  "Autonomous Driving",
  "Model Predictive Control",
  "Reinforcement Learning",
  "SLAM",
  "Visual Navigation",
];
---

<section class="flex flex-col-reverse items-center gap-8 sm:flex-row sm:items-start sm:justify-between">
  <div class="max-w-xl text-center sm:text-left">
    <h1 class="text-4xl font-semibold tracking-tight text-zinc-900">
      <span class="whitespace-nowrap">Kohei Honda</span>
      <span class="ml-1 inline-block whitespace-nowrap text-2xl font-normal text-zinc-400">本田 康平</span>
    </h1>

    <div class="mt-4 space-y-1 text-zinc-700">
      <p>
        Assistant Professor,
        <a
          href="https://www.suzlab.mae.nagoya-u.ac.jp/en/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-accent hover:text-accent-hover hover:underline"
        >
          Nagoya University
        </a>
      </p>
      <p>
        Research Scientist,
        <a
          href="https://research.cyberagent.ai/research/activity-understanding/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-accent hover:text-accent-hover hover:underline"
        >
          CyberAgent AI Lab
        </a>
      </p>
    </div>

    <div class="mt-5 flex flex-wrap justify-center gap-2 sm:justify-start">
      {
        keywords.map((keyword) => (
          <span class="rounded-full bg-accent/8 px-3 py-1 text-xs font-medium text-accent">
            {keyword}
          </span>
        ))
      }
    </div>

    <p class="mt-5 text-sm leading-relaxed text-zinc-600">
      I develop planning and control methods that enable mobile robots and
      autonomous vehicles to act reliably in the real world. I am particularly
      interested in bridging model-based and learning-based approaches, with the
      goal of robot intelligence that combines the rigor of control theory with
      the adaptability of machine learning.
    </p>

    <div class="mt-5 space-y-1 text-sm text-zinc-600">
      <p class="flex items-center justify-center gap-2 sm:justify-start">
        <Icon name="tabler:mail" class="h-4 w-4 shrink-0 text-zinc-400" />
        honda.kohei.k3[at]f.mail.nagoya-u.ac.jp ([at] &rarr; @)
      </p>
      <p class="flex items-center justify-center gap-2 sm:justify-start">
        <Icon name="tabler:map-pin" class="h-4 w-4 shrink-0 text-zinc-400" />
        Nagoya, Japan
      </p>
    </div>

    <div class="mt-6 flex justify-center sm:justify-start">
      <SocialLinks />
    </div>
  </div>

  <img
    src="/profile.jpg"
    alt="Portrait of Kohei Honda"
    width="640"
    height="640"
    class="h-36 w-36 shrink-0 rounded-full object-cover ring-1 ring-zinc-200 sm:h-44 sm:w-44"
  />
</section>
