---
export interface Props {
  title: string;
  subtitle?: string;
  desc?: string;
  url?: string;
}

const { title, subtitle, desc, url } = Astro.props;
---

<div class="flex gap-4">
  <div class="flex flex-col items-center">
    <div class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></div>
    <div class="timeline-line w-px grow bg-zinc-200"></div>
  </div>
  <div class="pb-8">
    <h3 class="font-medium leading-snug text-zinc-900">
      {
        url ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent hover:underline"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    {subtitle && <p class="mt-1 text-sm text-zinc-500">{subtitle}</p>}
    {desc && <p class="mt-1 text-sm text-zinc-600">{desc}</p>}
  </div>
</div>
